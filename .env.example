# =============================================================================
# Prem Mobile - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to '.env' in your project root:
#      cp .env.example .env
# 2. Fill in your own secret keys and configuration values below.
# 3. NEVER commit the actual '.env' file or any real secrets to Git/GitHub!
# =============================================================================

# Server & Application Settings
PORT=5000
NODE_ENV=development
ADMIN_JWT_SECRET=your_super_secret_jwt_key_min_32_characters
CORS_ORIGIN=http://localhost:5173

# Razorpay Payment Gateway (Test or Live API Keys)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere

# Cloudinary Storage Configuration (Client-side / Vite)
# Obtain from Cloudinary Console Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_UPLOAD_PRESET=prem_mobile_preset

# ─── VERCEL DEPLOYMENT (Frontend) ────────────────────────
# Set these in Vercel Dashboard → Project Settings → Environment Variables
# API_BACKEND_URL=https://your-app-name.onrender.com
# (Vercel rewrites proxy /api/* to this URL)

# ─── RENDER DEPLOYMENT (Backend API) ─────────────────────
# Set these in Render Dashboard → Service → Environment
# NODE_ENV=production
# PORT=5000 (Render sets this automatically)
# CORS_ORIGIN=https://your-app.vercel.app
# ADMIN_JWT_SECRET=your_production_secret_here

# ─── UPTIMEROBOT ─────────────────────────────────────────
# Health check URL: https://your-app-name.onrender.com/api/health
# Ping interval: Every 5 minutes
