# Prem Mobile Environment Configuration Example
# Copy this file to '.env' locally and replace with your actual values.
# NEVER commit the '.env' file to GitHub or git version control.

# Server Configuration
PORT=5000
ADMIN_JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Configuration (Image Uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
